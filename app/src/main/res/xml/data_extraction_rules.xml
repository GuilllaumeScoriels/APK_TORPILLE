<?xml version="1.0" encoding="utf-8"?>
<!--
Rôle :
- Règles de “data extraction” (Android 12+) : contrôle ce qui peut être extrait/sauvegardé.

Pourquoi comme ça :
- Donne un contrôle plus fin sur la confidentialité et la restauration des données.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="device_legal_acceptance.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="device_legal_acceptance.xml" />
    </device-transfer>
</data-extraction-rules>
